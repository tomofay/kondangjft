# ==============================================================================
# KONDANGSENSEI CBT - ENVIRONMENT VARIABLES TEMPLATE (.env)
# ==============================================================================
# Salin berkas ini ke `.env.local` (untuk development) atau isi di Environment Variables
# pada panel hosting Anda (Vercel / Railway / cPanel / VPS / Docker / Render).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Pilihan A: Koneksi Berbasis Parameter Terpisah (Localhost / VPS / cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_kondangsensei

# Pilihan B: Koneksi Berbasis DATABASE_URL Tunggal (Railway / Render / Cloud Managed DB)
# DATABASE_URL=mysql://user:password@host:port/database

# Aktifkan SSL untuk cloud database (Railway, Aiven, TiDB, PlanetScale, AWS RDS)
# Isi 'true' jika database hosting mewajibkan SSL
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. DOMAIN & WEB URL
# ------------------------------------------------------------------------------
# URL domain utama website (digunakan untuk return URL pembayaran DOKU & CORS)
# Contoh production: https://kondangsensei.my.id
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DOKU PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# Dapatkan kredensial ini dari DOKU Merchant Dashboard
DOKU_CLIENT_ID=BRN-0217-1792292490991
DOKU_SECRET_KEY=SK-exfHwYOtzTIzZi16bxSz
DOKU_API_KEY=doku_key_ab1c491ff95c4d48805cb7c2b840a276
DOKU_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n-----END PUBLIC KEY-----"

# Set 'true' untuk mode Live/Production, 'false' untuk Sandbox testing
DOKU_IS_PRODUCTION=true
