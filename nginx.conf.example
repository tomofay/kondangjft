server {
    listen 80;
    listen [::]:80;
    server_name kondangsensei.my.id www.kondangsensei.my.id;

    # Redirect all HTTP requests to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kondangsensei.my.id www.kondangsensei.my.id;

    # SSL certificates (Let's Encrypt Certbot)
    ssl_certificate /etc/letsencrypt/live/kondangsensei.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kondangsensei.my.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Proxy to Docker container (Next.js port 3000)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uploads limit (for PDF question importing)
    client_max_body_size 50M;
}
